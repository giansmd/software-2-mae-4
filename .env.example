# Plantilla de variables para Docker Compose.
# Para desarrollo puedes ejecutar `docker compose up` con este archivo o
# exportando variables. JWT_SECRET es OBLIGATORIO (el backend aborta el
# arranque si falta o es débil; ver SEC-001). Completa y descomenta solo
# lo que quieras sobreescribir (p.ej. para producción).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_DB=mae4
# POSTGRES_PASSWORD=<define-tu-password>        # defecto: postgres
# DATABASE_URL=postgresql://postgres:<password>@db:5432/mae4

# --- Backend ---
# JWT_SECRET (obligatorio, mínimo 32 caracteres): genera uno con:
#   openssl rand -hex 32
# JWT_SECRET=<pégalo-aquí>
# CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Frontend ---
# URL del backend tal como la ve el NAVEGADOR del usuario (host : puerto mapeado).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Seed / perfil demo (DOC-001) ---
# El seed crea credenciales demo conocidas (admin@mae4.dev, inv@mae4.dev,
# visit@mae4.dev) y datos de demostración. Está DESACTIVADO por defecto.
# Habilítalo SOLO para la demo local (docker compose ya lo fija en "true" en
# el perfil demo); nunca lo actives en un entorno compartido o de producción.
# SEED_ON_STARTUP=true

# --- Rate limiting (SEC-004 / RATE-001) ---
# Por defecto la cuota se aplica a la IP directa del peer e ignora
# X-Forwarded-For (fail-safe ante spoofing). Habilita solo si el backend está
# alcanzable únicamente a través de un proxy inverso de confianza:
# RATE_LIMIT_TRUST_PROXY=true
